@startuml
skinparam classAttributeIconSize 0

class Folder {
  - name : String
  - files : ArrayList<File>
  - subFolders : ArrayList<Folder>
  + Folder(name : String)
  + setName(name : String) : void
  + getName() : String
  + getFiles() : ArrayList<File>
  + getSubFolders() : ArrayList<Folder>
  + addFile(fileName : String) : void
  + addSubFolder(folderName : String) : Folder
  + deleteSubFolder(folderName : String) : boolean
  + print(indent : String) : void
}

class File {
  - name : String
  + File(name : String)
  + setName(name : String) : void
  + getName() : String
  + print(indent : String) : void
}

Folder "1" *-- "0..*" File : contains
Folder "1" *-- "0..*" Folder : contains
@enduml